{
    "name": "frontend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "npm run dev",
        "dev": "vite",
        "build": "vue-tsc && vite build",
        "preview": "vite preview",
        "type-check": "vue-tsc --noEmit",
        "lint": "npx prettier . --write",
        "generate:icons": "pwa-assets-generator && pwa-assets-generator -c pwa-assets.favicon.config.ts",
        "generate:api": "openapi-typescript ../api/openapi.yaml -o generated/schema.gen.ts && prettier --write generated/schema.gen.ts"
    },
    "dependencies": {
        "@fontsource/dm-sans": "^5.3.0",
        "@fontsource/dm-serif-display": "^5.3.0",
        "flag-icons": "^7.6.0",
        "maplibre-gl": "^6.10.0",
        "openapi-fetch": "^0.17.0",
        "pinia": "^4.0.3",
        "vue": "^3.5.42",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@types/node": "^22.20.3",
        "@vite-pwa/assets-generator": "^1.0.4",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/tsconfig": "^0.9.1",
        "openapi-typescript": "^7.13.0",
        "prettier": "3.9.10",
        "typescript": "~5.9.3",
        "vite": "^8.3.0",
        "vite-plugin-pwa": "^1.3.0",
        "vue-tsc": "^3.3.11"
    }
}
